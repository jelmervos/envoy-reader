<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<PublishAot>true</PublishAot>
		<UserSecretsId>33d5d1de-acd4-46bd-9f84-854586318c2b</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
		<PackageReference Include="NEnvoy" Version="*" />
		<PackageReference Include="Refit" Version="16.4.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
		<PackageReference Include="Refit.Newtonsoft.Json" Version="16.4.0" />
		<PackageReference Include="System.CommandLine" Version="2.0.14" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

</Project>
